---
// Eyebrow + heading + optional intro. Shared by Section, SplitFeature and others
// so every section header on the site looks the same.
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  as?: 'h1' | 'h2' | 'h3';
  align?: 'left' | 'center';
  id?: string;
  class?: string;
}

const { eyebrow, title, intro, as: Tag = 'h2', align = 'left', id, class: className } = Astro.props;
const centered = align === 'center';
---

<div class:list={[centered && 'mx-auto text-center', 'max-w-3xl', className]}>
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <Tag id={id} class:list={[Tag === 'h3' ? 'text-2xl md:text-3xl' : 'text-4xl md:text-5xl']}>{title}</Tag>
  {
    intro && (
      <p class:list={['mt-5 max-w-prose text-base leading-relaxed opacity-80 md:text-lg', centered && 'mx-auto']}>
        {intro}
      </p>
    )
  }
</div>
