---
// Image on one side, text on the other. `reverse` flips the sides on desktop so
// consecutive features can alternate down the page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '@/components/SectionHeading.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  eyebrow?: string;
  reverse?: boolean;
  aspect?: 'portrait' | 'landscape';
  headingLevel?: 'h2' | 'h3';
  id?: string;
}

const {
  image,
  imageAlt,
  title,
  eyebrow,
  reverse = false,
  aspect = 'landscape',
  headingLevel = 'h2',
  id,
} = Astro.props;
---

<div id={id} class="grid items-center gap-10 md:grid-cols-2 md:gap-16 lg:gap-20">
  <div data-reveal class:list={[reverse && 'md:order-2']}>
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1152px) 540px, (min-width: 768px) 46vw, 100vw"
      class:list={[
        'w-full rounded-2xl object-cover',
        aspect === 'portrait' ? 'aspect-[4/5]' : 'aspect-[4/3]',
      ]}
    />
  </div>
  <div data-reveal style="--reveal-delay: 120ms">
    <SectionHeading eyebrow={eyebrow} title={title} as={headingLevel} />
    <div class="mt-6 max-w-prose space-y-5 text-base leading-relaxed opacity-90 md:text-lg">
      <slot />
    </div>
    {
      Astro.slots.has('actions') && (
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</div>
