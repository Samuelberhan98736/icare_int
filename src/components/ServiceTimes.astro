---
// Service times from src/data/site.ts. "band" is the large centered home-page
// version; "cards" is the boxed version used on Visit and Contact.
import { site } from '@/data/site';

interface Props {
  variant?: 'band' | 'cards';
}

const { variant = 'band' } = Astro.props;
---

{
  variant === 'band' ? (
    <ul class="mx-auto grid max-w-4xl gap-10 text-center sm:grid-cols-2 sm:gap-6">
      {site.serviceTimes.map((service, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 100}ms`}>
          <p class="eyebrow">{service.day}s</p>
          <p class="mt-3 font-serif text-5xl font-semibold md:text-6xl">{service.time}</p>
          <p class="mt-2 text-base font-medium">{service.name}</p>
          {service.language && <p class="mt-1 text-sm text-muted">{service.language}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <ul class="grid gap-4 sm:grid-cols-2">
      {site.serviceTimes.map((service) => (
        <li class="rounded-2xl border border-line bg-white p-6">
          <p class="eyebrow">{service.day}s</p>
          <p class="mt-3 font-serif text-3xl font-semibold">{service.time}</p>
          <p class="mt-1 text-sm font-medium">{service.name}</p>
          {service.language && <p class="mt-1 text-sm text-muted">{service.language}</p>}
        </li>
      ))}
    </ul>
  )
}
