---
// 16:9 sermon thumbnail with a play overlay. Uses the YouTube thumbnail when the
// sermon has a video, otherwise a local placeholder.
import { Image } from 'astro:assets';
import placeholder from '@/assets/images/sermon-placeholder.jpg';
import { youtubeThumbnail } from '@/lib/content';

interface Props {
  youtubeId?: string;
  alt: string;
  size?: 'sm' | 'lg';
  eager?: boolean;
}

const { youtubeId, alt, size = 'sm', eager = false } = Astro.props;
const remote = youtubeThumbnail(youtubeId);
const imgClass =
  'aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]';
---

<div class="relative overflow-hidden rounded-2xl bg-forest-dark">
  {
    remote ? (
      <img src={remote} alt={alt} width="480" height="360" loading={eager ? 'eager' : 'lazy'} class={imgClass} />
    ) : (
      <Image
        src={placeholder}
        alt={alt}
        widths={[480, 960, 1280]}
        sizes={size === 'lg' ? '(min-width: 768px) 560px, 100vw' : '(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw'}
        loading={eager ? 'eager' : 'lazy'}
        class={imgClass}
      />
    )
  }
  <span class="absolute inset-0 flex items-center justify-center bg-ink/15" aria-hidden="true">
    <span
      class:list={[
        'flex items-center justify-center rounded-full bg-white/95 text-forest shadow-lg transition-transform duration-300 group-hover:scale-110',
        size === 'lg' ? 'h-20 w-20' : 'h-14 w-14',
      ]}
    >
      <svg viewBox="0 0 24 24" class:list={['translate-x-0.5', size === 'lg' ? 'h-8 w-8' : 'h-6 w-6']} fill="currentColor">
        <path d="M8 5.5v13l11-6.5-11-6.5Z"></path>
      </svg>
    </span>
  </span>
</div>
