---
// Contact form. Provider: Netlify Forms. Netlify detects the `data-netlify`
// attribute in the built HTML, so no server code is needed.
// To swap providers (e.g. Formspree), change `action`, remove the Netlify-specific
// attributes and hidden `form-name` field, and keep the visible fields as they are.
import Button from '@/components/Button.astro';

interface Props {
  name?: string;
  /** Where the visitor lands after a successful submission. */
  successPath?: string;
}

const { name = 'contact', successPath = '/contact/thanks' } = Astro.props;

const inputClass =
  'mt-2 block w-full rounded-xl border border-line bg-white px-4 py-3 text-base text-ink placeholder:text-muted/70 focus:border-forest focus:ring-2 focus:ring-forest/20 focus:outline-none';
---

<form
  name={name}
  method="POST"
  action={successPath}
  data-netlify="true"
  netlify-honeypot="bot-field"
  class="space-y-6"
>
  <input type="hidden" name="form-name" value={name} />
  <!-- Honeypot: hidden from people, filled in by bots, and rejected by Netlify. -->
  <p class="hidden" aria-hidden="true">
    <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <p class="text-sm text-muted">Fields marked <span class="text-forest" aria-hidden="true">*</span> are required.</p>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="text-sm font-medium">
        Name <span class="text-forest" aria-hidden="true">*</span>
      </label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required class={inputClass} />
    </div>
    <div>
      <label for="contact-email" class="text-sm font-medium">
        Email <span class="text-forest" aria-hidden="true">*</span>
      </label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required class={inputClass} />
    </div>
  </div>

  <div>
    <label for="contact-phone" class="text-sm font-medium">
      Phone <span class="font-normal text-muted">(optional)</span>
    </label>
    <input id="contact-phone" name="phone" type="tel" autocomplete="tel" class={inputClass} />
  </div>

  <div>
    <label for="contact-message" class="text-sm font-medium">
      Message <span class="text-forest" aria-hidden="true">*</span>
    </label>
    <textarea id="contact-message" name="message" rows="6" required class={inputClass}></textarea>
  </div>

  <Button type="submit">Send message</Button>
</form>
