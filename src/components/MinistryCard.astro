---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  ministry: CollectionEntry<'ministries'>;
}

const { ministry } = Astro.props;
const { title, summary, image, imageAlt } = ministry.data;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white transition-shadow duration-300 hover:shadow-lg hover:shadow-ink/5"
>
  {
    image ? (
      <div class="overflow-hidden">
        <Image
          src={image}
          alt={imageAlt ?? title}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
          class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    ) : (
      <div class="aspect-[4/3] bg-sand" aria-hidden="true" />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-2xl">
      <a href={`/ministries#${ministry.id}`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <p class="mt-2 leading-relaxed text-muted">{summary}</p>
  </div>
</article>
