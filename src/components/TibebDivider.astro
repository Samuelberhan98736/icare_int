---
// A thin geometric band inspired by tibeb, the woven borders on traditional
// Ethiopian cloth. Purely decorative; use sparingly (under the home hero, above the footer).
interface Props {
  /** "light" for paper/sand surroundings, "dark" for forest surroundings. */
  tone?: 'light' | 'dark';
  class?: string;
}

const { tone = 'light', class: className } = Astro.props;
// Each instance needs its own pattern id so multiple dividers on one page don't collide.
const patternId = `tibeb-${Math.random().toString(36).slice(2, 9)}`;
const background = tone === 'dark' ? 'bg-forest-dark' : 'bg-paper';
const primary = tone === 'dark' ? 'fill-gold' : 'fill-forest';
---

<div aria-hidden="true" class:list={['w-full py-2', background, className]}>
  <svg class="block h-4 w-full" xmlns="http://www.w3.org/2000/svg" focusable="false">
    <defs>
      <pattern id={patternId} width="32" height="16" patternUnits="userSpaceOnUse">
        <rect class="fill-gold" x="0" y="0" width="32" height="1" />
        <rect class="fill-gold" x="0" y="15" width="32" height="1" />
        <polygon class={primary} points="8,3 13,8 8,13 3,8" />
        <polygon class="fill-gold" points="24,5.5 26.5,8 24,10.5 21.5,8" />
        <rect class="fill-gold" x="15" y="7.5" width="2" height="1" />
        <rect class="fill-gold" x="29" y="7.5" width="3" height="1" />
        <rect class="fill-gold" x="0" y="7.5" width="1" height="1" />
      </pattern>
    </defs>
    <rect width="100%" height="16" fill={`url(#${patternId})`} />
  </svg>
</div>
