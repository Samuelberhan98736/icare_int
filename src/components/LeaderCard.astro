---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  role: string;
  image: ImageMetadata;
}

const { name, role, image } = Astro.props;
---

<figure>
  <Image
    src={image}
    alt={`Portrait of ${name}`}
    widths={[320, 640]}
    sizes="(min-width: 1024px) 260px, (min-width: 640px) 33vw, 50vw"
    class="aspect-[4/5] w-full rounded-2xl object-cover"
  />
  <figcaption class="mt-4">
    <p class="font-serif text-2xl font-semibold">{name}</p>
    <p class="mt-1 text-sm text-muted">{role}</p>
  </figcaption>
</figure>
