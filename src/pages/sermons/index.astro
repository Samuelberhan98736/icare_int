---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SermonCard from '@/components/SermonCard.astro';
import SermonThumbnail from '@/components/SermonThumbnail.astro';
import Button from '@/components/Button.astro';
import heroImage from '@/assets/images/page-sermons.jpg';
import { site } from '@/data/site';
import { getSermons } from '@/lib/content';
import { formatDate, isoDate } from '@/lib/dates';

const [latest, ...rest] = await getSermons();
---

<BaseLayout
  title="Sermons"
  description={`Watch recent sermons from ${site.pastor} and ${site.name}.`}
  transparentHeader
>
  <PageHero
    eyebrow="Sermons"
    title="Watch & Listen"
    intro="Missed a Sunday or want to hear a message again? Catch up on recent sermons here."
    image={heroImage}
    imageAlt="Pastor Teddy preaching on a Sunday morning"
  />

  {
    latest ? (
      <Section id="latest">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
          <a href={`/sermons/${latest.id}`} class="group block rounded-2xl" data-reveal>
            <SermonThumbnail
              youtubeId={latest.data.youtubeId}
              alt={`Watch “${latest.data.title}”`}
              size="lg"
              eager
            />
          </a>
          <div data-reveal style="--reveal-delay: 120ms">
            <p class="eyebrow mb-4">Latest Message{latest.data.series && ` · ${latest.data.series}`}</p>
            <h2 class="text-4xl md:text-5xl">{latest.data.title}</h2>
            <p class="mt-5 text-muted">
              {latest.data.speaker} · <time datetime={isoDate(latest.data.date)}>{formatDate(latest.data.date)}</time>
            </p>
            {latest.data.scripture && <p class="mt-1 text-muted">{latest.data.scripture}</p>}
            {latest.data.summary && <p class="mt-6 max-w-prose leading-relaxed md:text-lg">{latest.data.summary}</p>}
            <div class="mt-8">
              <Button href={`/sermons/${latest.id}`}>Watch now</Button>
            </div>
          </div>
        </div>
      </Section>
    ) : (
      <Section width="narrow" class="text-center">
        <h2 class="text-3xl">Sermons are coming soon</h2>
        <p class="mt-4 text-muted">In the meantime, visit our YouTube channel.</p>
      </Section>
    )
  }

  {
    rest.length > 0 && (
      <Section bg="sand" id="archive" eyebrow="Archive" title="Recent Sermons">
        <ul class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((sermon, i) => (
            <li data-reveal style={`--reveal-delay: ${(i % 3) * 100}ms`}>
              <SermonCard sermon={sermon} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section width="narrow" class="text-center">
    <div data-reveal>
      <p class="eyebrow">YouTube</p>
      <h2 class="mt-4 text-4xl md:text-5xl">Watch every service online</h2>
      <p class="mx-auto mt-5 max-w-prose leading-relaxed text-muted md:text-lg">
        Subscribe to our channel to watch services live and get notified when new sermons are posted.
      </p>
      <div class="mt-8">
        <Button href={site.social.youtube} external>Visit our YouTube channel</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
