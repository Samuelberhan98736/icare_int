---
// This page only links out to the church's giving platform.
// Never collect payment information on this site.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import heroImage from '@/assets/images/page-give.jpg';
import { site, mainService } from '@/data/site';

const otherWays = [
  {
    title: 'In Person',
    text: `Give during any ${mainService.day} service. Offering envelopes are available at the welcome table.`,
  },
  {
    title: 'By Mail',
    text: `Make checks payable to “${site.name}” and mail to: ${site.mailingAddress}`,
  },
  {
    title: 'Questions',
    text: `For giving statements or other questions, email ${site.email}.`,
  },
];
---

<BaseLayout
  title="Give"
  description={`Support the ministry of ${site.name} through online giving, in person, or by mail.`}
  transparentHeader
>
  <PageHero
    eyebrow="Give"
    title="Generosity Changes Lives"
    image={heroImage}
    imageAlt="Church volunteers serving the community"
  />

  <Section width="narrow" class="text-center">
    <div data-reveal>
      <blockquote class="font-serif text-3xl leading-snug font-semibold italic md:text-4xl">
        “Each of you should give what you have decided in your heart to give, not reluctantly or under compulsion,
        for God loves a cheerful giver.”
      </blockquote>
      <p class="eyebrow mt-6">2 Corinthians 9:7</p>
      <p class="mx-auto mt-10 max-w-prose text-base leading-relaxed text-muted md:text-lg">
        Your generosity supports our worship services, ministries for children and youth, care for families in
        need, and outreach across Atlanta and beyond. Thank you for partnering with us.
      </p>
      <div class="mt-10">
        <Button href={site.givingUrl} external class="px-10 py-4 text-base">Give Online</Button>
      </div>
      <p class="mt-4 text-sm text-muted">You'll be taken to our secure giving platform.</p>
    </div>
  </Section>

  <Section bg="sand" eyebrow="Other Ways to Give" title="More Ways to Give" id="other-ways">
    <ul class="grid gap-6 md:grid-cols-3">
      {
        otherWays.map((way, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 100}ms`} class="rounded-2xl border border-line bg-paper p-8">
            <h3 class="text-2xl">{way.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{way.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
