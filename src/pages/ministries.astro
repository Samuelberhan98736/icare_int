---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SplitFeature from '@/components/SplitFeature.astro';
import Button from '@/components/Button.astro';
import CtaBand from '@/components/CtaBand.astro';
import heroImage from '@/assets/images/page-ministries.jpg';
import fallbackImage from '@/assets/images/our-story.jpg';
import { site } from '@/data/site';
import { getMinistries } from '@/lib/content';

const ministries = await Promise.all(
  (await getMinistries()).map(async (ministry) => ({ ministry, Content: (await render(ministry)).Content })),
);
---

<BaseLayout
  title="Ministries"
  description={`Children, youth, women, men, worship, and prayer ministries at ${site.name}. Find your place to grow and serve.`}
  transparentHeader
>
  <PageHero
    eyebrow="Ministries"
    title="Find Your Place"
    image={heroImage}
    imageAlt="Church members serving together in one of our ministries"
  />

  <section class="bg-paper pt-20 md:pt-28" aria-label="Introduction">
    <div data-reveal class="mx-auto max-w-3xl px-6 text-center">
      <p class="font-serif text-3xl leading-snug md:text-4xl">
        Church is more than a Sunday service. It's a family where everyone has a place to belong, grow, and serve.
      </p>
    </div>
  </section>

  {
    ministries.map(({ ministry, Content }, i) => (
      <Section bg={i % 2 === 0 ? 'paper' : 'sand'} id={ministry.id}>
        <SplitFeature
          image={ministry.data.image ?? fallbackImage}
          imageAlt={ministry.data.imageAlt ?? ministry.data.title}
          title={ministry.data.title}
          eyebrow={ministry.data.summary}
          reverse={i % 2 === 1}
        >
          <Content />
          <Fragment slot="actions">
            <Button href="/contact" variant="ghost">
              Get involved
            </Button>
          </Fragment>
        </SplitFeature>
      </Section>
    ))
  }

  <CtaBand
    eyebrow="Get Involved"
    title="There's a place for you"
    text="Not sure where to start? Let us know what you're interested in and we'll help you connect."
    primary={{ label: 'Contact us', href: '/contact' }}
    secondary={{ label: 'Plan a Visit', href: site.visitLink.href }}
  />
</BaseLayout>
